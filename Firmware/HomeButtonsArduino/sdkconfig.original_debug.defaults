CONFIG_COMPILER_OPTIMIZATION_PERF=y

CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

CONFIG_BOOTLOADER_LOG_LEVEL_DEBUG=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_ARDUHAL_LOG_DEFAULT_LEVEL_DEBUG=y

CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y

# Route the console to USB CDC so logs come out of the USB-C connector
# instead of the TX/RX pins on the CMSIS-DAP header.
#
# Debug build only. Release stays on UART0 deliberately: UART works from
# the first ROM bootloader byte, survives deep sleep, and lets the device
# run on battery while you read logs. USB CDC does none of those, and the
# release build is the one that runs untethered.
#
# Caveats that apply here:
#   - The port only exists after USB enumeration, so bootloader and early
#     IDF output is still lost. Anything boot-related needs the UART pins.
#   - Deep sleep tears the USB device down; the port disappears and
#     re-enumerates on every wake. Turn on Awake Mode in the setup portal
#     while debugging to keep the device up and the port stable.
#   - ESP32-S2 has no USB_SERIAL_JTAG peripheral, so this goes through the
#     USB OTG controller and TinyUSB, not a dedicated console block.
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_USB_CDC=y
